{
  "name": "grassland-forest-sandbox",
  "version": "1.1.2",
  "private": true,
  "description": "Grassland Forest: cliente web aislado para escritorio",
  "author": "Grassland Forest",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "build:mac": "electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "@electron/fuses": "2.0.0"
  },
  "build": {
    "appId": "com.grasslandforest.game",
    "productName": "Grassland Forest",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "afterPack": "scripts/fuses.cjs",
    "win": {
      "target": "nsis",
      "artifactName": "Grassland-Forest-${version}-Windows-${arch}.${ext}",
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "artifactName": "Grassland-Forest-${version}-Linux-${arch}.${ext}",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "hardenedRuntime": true,
      "artifactName": "Grassland-Forest-${version}-macOS-${arch}.${ext}",
      "icon": "assets/icon.icns"
    }
  }
}
