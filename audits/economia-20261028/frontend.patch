+  assert.ok(replay.every(r => r.out.repetido));
+  assert.equal(b.stats._t[0].bronce, 200);
+  assert.equal(b.M.ServicioCobro._t.length, 1);
+  assert.equal(b.TesoroJuego._t[0].retenidoServicios, 100);
+});
