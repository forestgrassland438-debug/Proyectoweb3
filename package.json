    "test:libraries": "node --test tools/libraries-stability.test.cjs",
    "test:libraries:browser": "node tools/libraries-browser-stability.cjs",
    "build:vendor": "node tools/build-vendor.cjs",
    "test:engine": "node --test tools/engine-lifecycle.test.cjs tools/memory-diagnostics.test.cjs tools/app-lifecycle.test.cjs tools/perf-subsystems.test.cjs",
    "test:web3": "node --test tools/web3-seguridad-prueba.cjs tools/hub-lifecycle.test.cjs",
